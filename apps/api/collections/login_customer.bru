meta {
  name: Login Customer
  type: http
  seq: 39
}

post {
  url: {{host}}/api/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "alice.johnson@email.com",
    "password": "password123"
  }
}

docs {
  Logs in and returns a JWT token. Use the token in the {{token}} env var for authenticated requests.

  200 — { token, customer }.
  401 — invalid credentials (same for unknown email and wrong password).
  400 — invalid body.
}
